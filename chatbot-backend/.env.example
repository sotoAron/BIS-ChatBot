# Variables de entorno del backend IA Chatbot.
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env a control de versiones.

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# DEBE coincidir exactamente con IA_CHATBOT_JWT_SECRET del docker-compose de Moodle.
# Genera un valor seguro: openssl rand -hex 32
JWT_SECRET=CAMBIA_ESTO_POR_EL_MISMO_SECRETO_QUE_EN_MOODLE

# ── Servicios de infraestructura ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379
OLLAMA_BASE_URL=http://ollama:11434
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── Modelo LLM ────────────────────────────────────────────────────────────────
OLLAMA_MODEL=qwen2.5:3b

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ── Rate Limiting (Sliding Window) ───────────────────────────────────────────
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# ── Caché Semántica ───────────────────────────────────────────────────────────
# Umbral de similitud coseno para considerar una pregunta como "igual" (0.0-1.0)
SEMANTIC_CACHE_THRESHOLD=0.92
# TTL de las entradas en caché (segundos). 0 = sin expiración.
SEMANTIC_CACHE_TTL=3600

# ── Entorno ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
